<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Outfit:wght@100..900&display=swap" rel="stylesheet">

<style>
  :root {
    --bg-gradient: radial-gradient(circle at top, #111827 0%, #030712 100%);
    --card-bg: rgba(31, 41, 55, 0.45);
    --border-color: rgba(255, 255, 255, 0.08);
    --text-primary: #f9fafb;
    --text-secondary: #9ca3af;
    --accent: #10b981;
    --accent-glow: rgba(16, 185, 129, 0.4);
    --shadow: 0 10px 40px 0 rgba(0, 0, 0, 0.5);
  }

  body {
    background: var(--bg-gradient);
    font-family: 'Outfit', sans-serif;
    color: var(--text-primary);
    min-height: 100vh;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-y: auto;
    padding: 40px 0;
  }

  .container {
    width: 90%;
    max-width: 800px;
    margin: auto;
  }

  .lab-card {
    background: rgba(17, 24, 39, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border-color);
    border-radius: 32px;
    padding: 40px;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .lab-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 2.2rem;
    color: #34d399;
    margin-bottom: 8px;
    text-shadow: 0 4px 15px rgba(52, 211, 153, 0.3);
  }

  .lab-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 35px;
  }

  /* Selector de región */
  .region-tabs {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 30px;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    padding: 10px 24px;
    border-radius: 20px;
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tab-btn.active {
    background: var(--accent);
    box-shadow: 0 4px 15px var(--accent-glow);
    border-color: transparent;
  }

  /* Listado de iniciales */
  .starters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
    transition: all 0.3s ease;
  }

  .starter-card {
    background: var(--card-bg);
    border: 2px solid transparent;
    border-radius: 24px;
    padding: 24px;
    cursor: pointer;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .starter-card:hover {
    transform: translateY(-6px);
    background: rgba(55, 65, 81, 0.5);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
  }

  .starter-card.selected {
    border-color: var(--accent);
    background: rgba(16, 185, 129, 0.08);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .starter-sprite-container {
    height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }

  .starter-sprite {
    max-width: 80px;
    max-height: 80px;
    image-rendering: pixelated;
    transition: transform 0.3s ease;
  }

  .starter-card:hover .starter-sprite {
    transform: scale(1.15);
  }

  .starter-name {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.3rem;
    margin: 5px 0 2px 0;
  }

  .starter-type {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 10px;
    margin-top: 5px;
  }

  /* Formulario y nickname */
  .adoption-form {
    max-width: 400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .input-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .input-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .nickname-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 14px 20px;
    font-size: 1.1rem;
    color: white;
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
    transition: all 0.3s ease;
  }

  .nickname-input:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
  }

  .submit-btn {
    width: 100%;
    border: none;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    font-family: 'Fredoka', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    padding: 16px 32px;
    border-radius: 20px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    filter: brightness(1.1);
  }

  .submit-btn:active {
    transform: translateY(1px);
  }

  .submit-btn:disabled {
    background: #4b5563;
    color: #9ca3af;
    box-shadow: none;
    cursor: not-allowed;
    transform: none;
    filter: none;
  }

  /* Ocultar elementos según pestaña */
  .hidden {
    display: none !important;
  }

  .error-message {
    color: #ef4444;
    font-size: 0.9rem;
    margin-top: 5px;
    text-align: left;
  }
</style>

<div class="container">
  <div class="lab-card">
    <h1 class="lab-title">El Laboratorio de Pokéchi</h1>
    <p class="lab-subtitle">¡Bienvenido! Elige a tu Pokémon inicial para comenzar a cuidarlo.</p>

    <!-- Selector de Región -->
    <div class="region-tabs">
      <button type="button" class="tab-btn active" onclick="switchRegion('Kanto')">Kanto (Gen 1 Retro)</button>
      <button type="button" class="tab-btn" onclick="switchRegion('Paldea')">Paldea (Gen 9 Moderna)</button>
    </div>

    <%= form_with model: @pokemon, url: pokemons_path, local: true, class: "adoption-form", id: "adoption-form" do |f| %>
      <!-- Campo oculto para registrar la especie seleccionada -->
      <%= f.hidden_field :species, id: "pokemon_species_input" %>

      <!-- Grid de Pokémon -->
      <div class="starters-grid">
        <% @starters.each do |starter| %>
          <div class="starter-card" 
               data-species="<%= starter[:species] %>" 
               data-region="<%= starter[:region] %>"
               onclick="selectStarter(this)">
            <div class="starter-sprite-container">
              <img src="<%= starter[:sprite] %>" alt="<%= starter[:species] %>" class="starter-sprite">
            </div>
            <h3 class="starter-name"><%= starter[:species] %></h3>
            <span class="starter-type"><%= starter[:type] %></span>
          </div>
        <% end %>
      </div>

      <!-- Nombre del Pokémon -->
      <div class="input-group">
        <label for="pokemon_name" class="input-label">Dale un apodo especial a tu compañero:</label>
        <%= f.text_field :name, id: "pokemon_name", placeholder: "Ej. Pantufla, Sparky...", class: "nickname-input", required: true %>
        <% if @pokemon.errors[:name].any? %>
          <div class="error-message">El apodo <%= @pokemon.errors[:name].join(', ') %></div>
        <% end %>
      </div>

      <!-- Botón de Envío -->
      <%= f.submit "¡Comenzar Aventura!", class: "submit-btn", id: "submit-btn", disabled: true %>
    <% end %>
  </div>
</div>

<script>
  // Cambia la pestaña de iniciales mostrada (Kanto vs Paldea)
  function switchRegion(region) {
    // Actualizar botones
    const buttons = document.querySelectorAll('.tab-btn');
    buttons.forEach(btn => {
      if (btn.textContent.includes(region)) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Filtrar tarjetas
    const cards = document.querySelectorAll('.starter-card');
    cards.forEach(card => {
      if (card.getAttribute('data-region') === region) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Maneja la selección del inicial al hacer click en la tarjeta
  function selectStarter(cardElement) {
    // Quitar selección previa de todas las tarjetas
    const cards = document.querySelectorAll('.starter-card');
    cards.forEach(c => c.classList.remove('selected'));

    // Marcar como seleccionado la tarjeta cliqueada
    cardElement.classList.add('selected');

    // Actualizar el valor del input hidden
    const species = cardElement.getAttribute('data-species');
    document.getElementById('pokemon_species_input').value = species;

    // Habilitar el botón de submit
    document.getElementById('submit-btn').disabled = false;
  }

  // Inicializar mostrando la región de Kanto
  document.addEventListener("DOMContentLoaded", () => {
    switchRegion('Kanto');
  });
</script>
