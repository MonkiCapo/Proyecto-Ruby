<div class="container">
  <div class="lab-card">
    <h1 class="lab-title">El Laboratorio de Pokéchi</h1>
    <p class="lab-subtitle">¡Bienvenido! Elige a tu Pokémon inicial para comenzar a cuidarlo.</p>

    <!-- Selector de Región -->
    <div class="region-tabs">
      <button type="button" class="tab-btn active" onclick="switchRegion('Kanto')">Kanto (Gen 1 Retro)</button>
      <button type="button" class="tab-btn" onclick="switchRegion('Paldea')">Paldea (Gen 9 Moderna)</button>
    </div>

    <%= form_with model: @pokemon, url: pokemons_path, local: true, class: "adoption-form", id: "adoption-form" do |f| %>
      <!-- Campo oculto para registrar la especie seleccionada -->
      <%= f.hidden_field :species, id: "pokemon_species_input" %>

      <!-- Grid de Pokémon -->
      <div class="starters-grid">
        <% @starters.each do |starter| %>
          <div class="starter-card" 
               data-species="<%= starter[:species] %>" 
               data-region="<%= starter[:region] %>"
               onclick="selectStarter(this)">
            <div class="starter-sprite-container">
              <img src="<%= starter[:sprite] %>" alt="<%= starter[:species] %>" class="starter-sprite">
            </div>
            <h3 class="starter-name"><%= starter[:species] %></h3>
            <span class="starter-type"><%= starter[:type] %></span>
          </div>
        <% end %>
      </div>

      <!-- Nombre del Pokémon -->
      <div class="input-group">
        <label for="pokemon_name" class="input-label">Dale un apodo especial a tu compañero:</label>
        <%= f.text_field :name, id: "pokemon_name", placeholder: "Ej. Pantufla, Sparky...", class: "nickname-input", required: true %>
        <% if @pokemon.errors[:name].any? %>
          <div class="error-message">El apodo <%= @pokemon.errors[:name].join(', ') %></div>
        <% end %>
      </div>

      <!-- Botón de Envío -->
      <%= f.submit "¡Comenzar Aventura!", class: "submit-btn", id: "submit-btn", disabled: true %>
    <% end %>
  </div>
</div>

<script>
  // Cambia la pestaña de iniciales mostrada (Kanto vs Paldea)
  function switchRegion(region) {
    // Actualizar botones
    const buttons = document.querySelectorAll('.tab-btn');
    buttons.forEach(btn => {
      if (btn.textContent.includes(region)) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Filtrar tarjetas
    const cards = document.querySelectorAll('.starter-card');
    cards.forEach(card => {
      if (card.getAttribute('data-region') === region) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Maneja la selección del inicial al hacer click en la tarjeta
  function selectStarter(cardElement) {
    // Quitar selección previa de todas las tarjetas
    const cards = document.querySelectorAll('.starter-card');
    cards.forEach(c => c.classList.remove('selected'));

    // Marcar como seleccionado la tarjeta cliqueada
    cardElement.classList.add('selected');

    // Actualizar el valor del input hidden
    const species = cardElement.getAttribute('data-species');
    document.getElementById('pokemon_species_input').value = species;

    // Habilitar el botón de submit
    document.getElementById('submit-btn').disabled = false;
  }

  // Inicializar mostrando la región de Kanto
  document.addEventListener("DOMContentLoaded", () => {
    switchRegion('Kanto');
  });
</script>
