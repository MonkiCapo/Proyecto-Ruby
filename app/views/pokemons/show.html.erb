<!-- Cargamos fuentes modernas y lúdicas desde Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Outfit:wght@100..900&display=swap" rel="stylesheet">

<style>
  :root {
    --bg-gradient: radial-gradient(circle at top, #1a2c29 0%, #0c100e 100%);
    --card-bg: rgba(20, 32, 26, 0.6);
    --border-color: rgba(62, 137, 98, 0.25);
    --text-primary: #f0fdf4;
    --text-secondary: #a7f3d0;
    --accent-green: #10b981;
    --accent-red: #f43f5e;
    --accent-yellow: #fbbf24;
    --xp-color: #3b82f6;
    --shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  }

  body {
    background: var(--bg-gradient);
    font-family: 'Outfit', sans-serif;
    color: var(--text-primary);
    min-height: 100vh;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-y: auto;
    padding: 30px 0;
  }

  .game-container {
    width: 90%;
    max-width: 480px;
    margin: auto;
  }

  /* Título de la app */
  .brand-header {
    text-align: center;
    font-family: 'Fredoka', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #4ade80;
    text-shadow: 0 4px 12px rgba(74, 222, 128, 0.3);
    margin-bottom: 20px;
    letter-spacing: 1px;
  }

  /* Cabecera para cambio rápido de Pokémon */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(20, 32, 26, 0.4);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 12px 20px;
    margin-bottom: 20px;
  }

  .pokemon-selector-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-grow: 1;
  }

  .switch-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .pokemon-select {
    background: rgba(17, 24, 39, 0.8);
    border: 1px solid var(--border-color);
    color: white;
    padding: 8px 14px;
    border-radius: 12px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    cursor: pointer;
    outline: none;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 180px;
  }

  .pokemon-select:focus {
    border-color: #4ade80;
    box-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
  }

  .btn-adopt {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    font-family: 'Fredoka', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-adopt:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(16, 185, 129, 0.35);
    filter: brightness(1.1);
  }

  /* Tarjeta principal con Glassmorphism */
  .pokemon-card {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: 28px;
    padding: 30px;
    box-shadow: var(--shadow);
    text-align: center;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .pokemon-card:hover {
    border-color: rgba(74, 222, 128, 0.5);
  }

  /* Notificaciones Flash */
  .flash-notice {
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.5);
    color: #a7f3d0;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
    margin-bottom: 20px;
    animation: fadeInDown 0.4s ease forwards;
  }

  .flash-alert {
    background: rgba(244, 63, 94, 0.2);
    border: 1px solid rgba(244, 63, 94, 0.5);
    color: #fecdd3;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
    margin-bottom: 20px;
    animation: fadeInDown 0.4s ease forwards;
  }

  /* Encabezado del Pokémon */
  .pokemon-header {
    margin-bottom: 15px;
  }

  .pokemon-name {
    font-family: 'Fredoka', sans-serif;
    font-size: 2.2rem;
    margin: 0;
    font-weight: 600;
  }

  .pokemon-species-badge {
    display: inline-block;
    background: rgba(74, 222, 128, 0.15);
    border: 1px solid rgba(74, 222, 128, 0.3);
    color: #a7f3d0;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    margin-top: 6px;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  /* Contenedor del Sprite / Entorno */
  .sprite-container {
    height: 200px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
    border-radius: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    margin: 20px 0;
    overflow: hidden;
    cursor: pointer;
  }

  /* Sprite Original Animado (desde Showdown) */
  .pokemon-sprite-img {
    height: 100px;
    image-rendering: auto;
    animation: idleFloat 3s ease-in-out infinite;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* Animación de flotar (idle) */
  @keyframes idleFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.02); }
  }

  /* Efecto de agrandarse y mirar al usuario al pasar el mouse */
  .sprite-container:hover .pokemon-sprite-img {
    transform: scale(1.25) translateY(-5px);
    filter: drop-shadow(0 8px 16px rgba(74, 222, 128, 0.45));
  }

  /* Sección de Estadísticas */
  .stats-section {
    display: flex;
    flex-direction: column;
    gap: 15px;
    text-align: left;
    margin-top: 25px;
  }

  .stat-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .stat-label-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .stat-label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }

  .stat-val {
    font-weight: 700;
  }

  /* Barras de progreso custom */
  .progress-bg {
    background: rgba(255, 255, 255, 0.08);
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .progress-fill {
    height: 100%;
    border-radius: 6px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Colores de las barras */
  .xp-fill {
    background: linear-gradient(90deg, #2563eb, #60a5fa);
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
  }

  .hunger-fill {
    transition: width 0.6s ease, background 0.6s ease;
  }

  .happiness-fill {
    transition: width 0.6s ease, background 0.6s ease;
  }

  /* Badge de estado de ánimo */
  .mood-badge {
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.3);
    color: #fde047;
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 15px;
  }

  /* Botones de acción */
  .actions-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 30px;
  }

  .btn-action {
    border: none;
    padding: 14px 20px;
    border-radius: 16px;
    font-family: 'Fredoka', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: white;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    transition: transform 0.15s ease, box-shadow 0.2s ease, filter 0.2s ease;
    text-decoration: none;
  }

  .btn-feed {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
  }

  .btn-feed:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    filter: brightness(1.1);
  }

  .btn-feed:active {
    transform: translateY(1px);
  }

  .btn-play {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
  }

  .btn-play:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
    filter: brightness(1.1);
  }

  .btn-play:active {
    transform: translateY(1px);
  }

  /* Info Footer */
  .interaction-footer {
    margin-top: 20px;
    font-size: 0.8rem;
    color: rgba(240, 253, 244, 0.4);
  }

  /* Keyframe animations */
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<div class="game-container">
  <div class="brand-header">
    Pokéchi Poké-Care
  </div>

  <!-- Barra de navegación superior (Selector de Pokémon) -->
  <% if @all_pokemons.present? && @all_pokemons.size > 0 %>
    <div class="top-bar">
      <div class="pokemon-selector-wrapper">
        <label for="pokemon_selector" class="switch-label">Compañero:</label>
        <select id="pokemon_selector" class="pokemon-select" onchange="window.location.href = this.value;">
          <% @all_pokemons.each do |p| %>
            <option value="<%= pokemon_path(p) %>" <%= 'selected' if p == @pokemon %>><%= p.name %> (<%= p.species %>)</option>
          <% end %>
        </select>
      </div>
      <%= link_to "+ Adoptar", new_pokemon_path, class: "btn-adopt" %>
    </div>
  <% end %>

  <!-- Alertas Flash -->
  <% if flash[:notice].present? %>
    <div class="flash-notice">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="flash-alert">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <!-- Tarjeta Principal -->
  <div class="pokemon-card">
    <div class="pokemon-header">
      <h2 class="pokemon-name"><%= @pokemon.name %></h2>
      <span class="pokemon-species-badge">
        <%= @pokemon.species %>
      </span>
    </div>

    <!-- Contenedor del Sprite Original de Showdown -->
    <div class="sprite-container" title="¡Pasa el mouse para interactuar!">
      <img src="<%= @pokemon.sprite_url %>" alt="<%= @pokemon.species %>" class="pokemon-sprite-img">
    </div>

    <!-- Badge del Estado de Ánimo -->
    <div class="mood-badge">
      <span>Estado:</span>
      <strong><%= @pokemon.mood %></strong>
    </div>

    <!-- Sección de Estadísticas -->
    <div class="stats-section">
      <!-- Nivel y XP -->
      <div class="stat-group">
        <div class="stat-label-container">
          <span class="stat-label">
            <span>⭐</span> Nivel / Experiencia
          </span>
          <span class="stat-val">
            Niv. <%= @pokemon.level %> (<%= @pokemon.experience %> / <%= @pokemon.level * 100 %> XP)
          </span>
        </div>
        <div class="progress-bg">
          <% xp_percentage = (@pokemon.experience.to_f / (@pokemon.level * 100) * 100).clamp(0, 100) %>
          <div class="progress-fill xp-fill" style="width: <%= xp_percentage %>%;"></div>
        </div>
      </div>

      <!-- Hambre (0 es lleno, 100 es hambriento) -->
      <div class="stat-group">
        <div class="stat-label-container">
          <span class="stat-label">
            <span>🍖</span> Nivel de Hambre
          </span>
          <span class="stat-val">
            <%= @pokemon.hunger %> / 100
          </span>
        </div>
        <div class="progress-bg">
          <% 
            hunger_percentage = @pokemon.hunger
            hunger_color = if hunger_percentage > 80
                             "linear-gradient(90deg, #f43f5e, #e11d48)" # Rojo
                           elsif hunger_percentage > 50
                             "linear-gradient(90deg, #fb923c, #ea580c)" # Naranja
                           else
                             "linear-gradient(90deg, #34d399, #059669)" # Verde
                           end
          %>
          <div class="progress-fill hunger-fill" style="width: <%= hunger_percentage %>%; background: <%= hunger_color %>;"></div>
        </div>
      </div>

      <!-- Felicidad -->
      <div class="stat-group">
        <div class="stat-label-container">
          <span class="stat-label">
            <span>💖</span> Felicidad
          </span>
          <span class="stat-val">
            <%= @pokemon.happiness %> / 100
          </span>
        </div>
        <div class="progress-bg">
          <% 
            happiness_percentage = @pokemon.happiness
            happiness_color = if happiness_percentage > 80
                                "linear-gradient(90deg, #ec4899, #db2777)" # Rosa
                              elsif happiness_percentage > 40
                                "linear-gradient(90deg, #10b981, #059669)" # Verde
                              else
                                "linear-gradient(90deg, #f43f5e, #e11d48)" # Rojo
                              end
          %>
          <div class="progress-fill happiness-fill" style="width: <%= happiness_percentage %>%; background: <%= happiness_color %>;"></div>
        </div>
      </div>
    </div>

    <!-- Botones de Acción -->
    <div class="actions-container">
      <%= button_to feed_pokemon_path(@pokemon), method: :post, class: "btn-action btn-feed" do %>
        <span>🍎 Alimentar</span>
      <% end %>

      <%= button_to play_pokemon_path(@pokemon), method: :post, class: "btn-action btn-play" do %>
        <span>🧸 Jugar</span>
      <% end %>
    </div>

    <div class="interaction-footer">
      <% if @pokemon.last_interaction.present? %>
        Última interacción: <%= @pokemon.last_interaction.strftime("%d/%m/%Y %H:%M:%S") %>
      <% else %>
        Aún no has interactuado con él.
      <% end %>
    </div>
  </div>
</div>
